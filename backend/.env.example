# ── App ─────────────────────────────────────────────────────────────────────
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── NLP Models ───────────────────────────────────────────────────────────────
# Options: grammarly/coedit-large | grammarly/coedit-xl | vennify/t5-base-grammar-correction
HF_MODEL_NAME=grammarly/coedit-large
# Options: cpu | cuda
HF_DEVICE=cpu

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_GRAMMAR_CHECK=true
ENABLE_CONTEXT_MODEL=true

# ── Supabase (optional — leave blank to disable) ─────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
