# ── App ─────────────────────────────────────────────────────────────────────
APP_DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── NLP Models ───────────────────────────────────────────────────────────────
# Options: grammarly/coedit-large | grammarly/coedit-xl | vennify/t5-base-grammar-correction
HF_MODEL_NAME=grammarly/coedit-large
# Options: cpu | cuda
HF_DEVICE=cpu

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_GRAMMAR_CHECK=true
# Set to false on low-memory servers (skips the 1.5GB CoEdIT model)
ENABLE_CONTEXT_MODEL=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CHECK=30/minute
RATE_LIMIT_CORRECT=10/minute

# ── Supabase (optional — leave blank to disable) ─────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

